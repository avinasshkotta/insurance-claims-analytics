{
  "version": 1,
  "description": "Golden set for the RAG layer. Offline mode checks retrieval + refusal deterministically; --live checks the model's answered text with citations.",
  "thresholds": {
    "pass_rate": 0.85,
    "top1_accuracy": 0.85,
    "retrieval_hit_rate": 0.9,
    "refusal_accuracy": 1.0,
    "keyword_coverage": 0.85
  },
  "cases": [
    {
      "id": "auto_ca_rental_limit",
      "claim_id": "CLM-1041",
      "claim_type": "auto",
      "region": "CA",
      "query": "What is the daily rental reimbursement limit?",
      "expected_doc": "POLICY-AUTO-CA",
      "must_include": ["$50"],
      "must_not_include": ["$35"],
      "should_refuse": false
    },
    {
      "id": "auto_ca_rental_max",
      "claim_id": "CLM-1041",
      "claim_type": "auto",
      "region": "CA",
      "query": "What is the maximum rental reimbursement per claim?",
      "expected_doc": "POLICY-AUTO-CA",
      "must_include": ["$1,500"],
      "must_not_include": ["$1,050"],
      "should_refuse": false
    },
    {
      "id": "auto_tx_rental_limit",
      "claim_type": "auto",
      "region": "TX",
      "query": "What is the daily rental reimbursement limit?",
      "expected_doc": "POLICY-AUTO-TX",
      "must_include": ["$35"],
      "must_not_include": ["$50"],
      "should_refuse": false
    },
    {
      "id": "home_tx_filing_deadline",
      "claim_id": "CLM-1043",
      "claim_type": "home",
      "region": "TX",
      "query": "What is the filing deadline for claims?",
      "expected_doc": "POLICY-HOME-TX",
      "must_include": ["2 years"],
      "must_not_include": [],
      "should_refuse": false
    },
    {
      "id": "home_tx_flood_exclusion",
      "claim_type": "home",
      "region": "TX",
      "query": "Is rising floodwater damage excluded?",
      "expected_doc": "POLICY-HOME-TX",
      "must_include": ["flood"],
      "must_include_any": [["excluded", "not covered", "does not cover"]],
      "must_not_include": [],
      "should_refuse": false
    },
    {
      "id": "health_ny_prior_auth",
      "claim_id": "CLM-1045",
      "claim_type": "health",
      "region": "NY",
      "query": "Is prior authorization required for an MRI?",
      "expected_doc": "POLICY-HEALTH-NY",
      "must_include": ["prior authorization"],
      "must_not_include": [],
      "should_refuse": false
    },
    {
      "id": "health_ny_deductible",
      "claim_type": "health",
      "region": "NY",
      "query": "Does the annual deductible apply to diagnostic services?",
      "expected_doc": "POLICY-HEALTH-NY",
      "must_include": ["deductible"],
      "must_not_include": [],
      "should_refuse": false
    },
    {
      "id": "refusal_health_tx",
      "claim_type": "health",
      "region": "TX",
      "query": "What is my deductible?",
      "expected_doc": null,
      "must_include": [],
      "must_not_include": [],
      "should_refuse": true
    },
    {
      "id": "refusal_auto_ny",
      "claim_type": "auto",
      "region": "NY",
      "query": "What is the rental limit?",
      "expected_doc": null,
      "must_include": [],
      "must_not_include": [],
      "should_refuse": true
    }
  ]
}
