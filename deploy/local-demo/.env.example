# Copy to .env in this folder. The app's own secrets come from ../../.env.
DOMAIN=claims-demo.duckdns.org

# DuckDNS token (duckdns.org -> your account). Used by duckdns-update.ps1
# and by the ClaimsDemo-Dns scheduled task.
DUCKDNS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Optional second project (QuenchGuard) ---------------------------------
# Uncomment both lines to serve it from the same Caddy on the same public IP.
# QUENCH_DOMAIN=quench-demo.duckdns.org
# CADDYFILE=Caddyfile.both
