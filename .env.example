# Copy to .env and fill in. Any OpenAI-compatible endpoint works.
OPENAI_API_KEY=sk-your-key-here
# Optional: point at a proxy/gateway (Azure, Ollama, vLLM, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Shared secret required by the MCP servers (>= 8 chars). Change for shared use.
MCP_AUTH_TOKEN=local-demo-token

# --- Public demo mode -------------------------------------------------------
# Set DEMO_MODE=1 when the app is reachable by strangers: per-IP rate limit,
# hard daily spend cap, uploads disabled.
DEMO_MODE=0
DEMO_RPM=12
DEMO_DAILY_USD=2.00
DEMO_ALLOW_UPLOADS=0
# Generation ceiling on every call (all modes).
MAX_OUTPUT_TOKENS=700
