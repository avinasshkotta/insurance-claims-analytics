# Secrets — never commit API keys
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Test / tooling caches
.pytest_cache/

# Frontend
frontend/node_modules/
frontend/dist/

# runtime output
data/case_queue.json
data/llm_usage.jsonl
data/runs.jsonl
data/uploads/

# build inputs — committed on purpose so CI/CD and PaaS builds work from a
# clean checkout (a Dockerfile that COPYs them fails otherwise):
#   data/embeddings.json   -> hybrid retrieval, regenerate with `cli reindex`
#   models/*.joblib        -> severity model, regenerate with `cli ml`

# presentation artifacts — guide, report, Q&A, interview pack (never commit)
docs/*.pdf
docs/*.png
docs/*.html
docs/eval_report.json

# Trained artifacts are committed (see the build-inputs note above).

# Local demo tooling, logs and runtime config
deploy/local-demo/tools/
deploy/local-demo/boot.log
deploy/local-demo/.env
deploy/local-demo/.credentials.txt
