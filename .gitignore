# Secrets — never commit API keys
.env

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Test / tooling caches
.pytest_cache/

# Frontend
frontend/node_modules/
frontend/dist/

# runtime output
data/case_queue.json
data/llm_usage.jsonl
