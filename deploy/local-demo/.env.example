# Copy to .env in this folder. The app's own secrets come from ../../.env.
# Your DuckDNS subdomain, without https:// and without .duckdns.org
DOMAIN=yourname.duckdns.org

# DuckDNS token (duckdns.org -> your account). Only needed by duckdns-update.ps1.
DUCKDNS_TOKEN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
